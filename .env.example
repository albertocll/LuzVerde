# Copia este archivo como .env y rellena los valores. .env no se sube al repo.
DB_USER=luzverde
DB_PASSWORD=cambia-esto
# Genera una clave con: openssl rand -base64 48
JWT_SECRET=
# Clave de la API de Claude. Opcional: sin ella el evaluador y el generador de CV responden 503.
ANTHROPIC_API_KEY=
# Versión mínima de la app (1.2.3). Súbela si un cambio de la API rompe versiones antiguas.
# APP_VERSION_MINIMA=1.0.0
